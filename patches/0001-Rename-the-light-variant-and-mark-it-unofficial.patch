--- a/apps/desktop/product-identity.cjs
+++ b/apps/desktop/product-identity.cjs
@@ -11,7 +11,8 @@
 const variants = {
   '': { display: 'Hermes', kebab: 'hermes', pascal: 'Hermes' },
   light: {
-    display: 'Hermes Light',
+    // hermes-desktop-portable(identity): this project's name for the light variant.
+    display: 'Hermes Portable',
     kebab: 'hermes-light',
     pascal: 'HermesLight'
   },
@@ -71,7 +72,8 @@ const identity = {
   channel: store || buildCommit ? null : light ? (canary ? 'light-canary' : 'light') : (canary ? 'canary' : 'latest'),
   appNamePascal: `${name.pascal}${pascalSuffix}`,
   artifactNamePascal: name.pascal,
-  windowsExecutableName: kebabSuffix ? cliName : displayName,
+  // hermes-desktop-portable(identity): no spaces in the executable name.
+  windowsExecutableName: kebabSuffix ? cliName : light ? 'HermesPortable' : displayName,
   cliName,
   msixAppIdWithOrg: `NousResearch.${name.pascal}${pascalSuffix}`,
   ...(store
