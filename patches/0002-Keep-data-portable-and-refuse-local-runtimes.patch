From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes-desktop-portable <build@hermes-desktop-portable.invalid>
Date: Mon, 19 Oct 2026 15:55:07 +0000
Subject: [PATCH] Keep data portable and refuse local runtimes

hermes-desktop-portable ships a portable ZIP of upstream's light variant.
Its promises are that deleting the folder uninstalls it, and that it only
connects to Hermes gateways running elsewhere. Where upstream already has
a switch for a behavior, entry.ts sets it before main is imported; code
changes are kept for what no switch covers.

Portable data. Upstream writes to %APPDATA%\Hermes,
%LOCALAPPDATA%\hermes\logs and the HKCU hermes:// handler, and stores
gateway tokens unencrypted by default.

- Default HERMES_DESKTOP_USER_DATA_DIR to data\ next to the executable in
  packaged Windows builds, which also moves the Hermes home under it.
- Pin HERMES_HOME to data\hermes-home, because an inherited HERMES_HOME
  (left by an official install) takes precedence over data\.
- Set HERMES_DESKTOP_SKIP_PROTOCOL_REGISTRATION so no hermes:// handler
  is registered.
- Do not create the default %APPDATA%\Hermes folder while applying the
  product identity when HERMES_DESKTOP_USER_DATA_DIR is set.
- Default token storage to DPAPI encryption on Windows when no choice has
  been saved.

Remote-only. Upstream's light variant ships no runtime, but it still uses
a Hermes installed on the machine, and it runs the first-launch bootstrap
when anything asks for a local backend, such as the registry's mandatory
"This device" entry right after first-run setup. The bootstrap fetches
install.ps1 for the build commit, which for this project is the patched
upstream HEAD and does not exist on GitHub (404). Its failure is latched
globally, so the remote primary stops working too until the app restarts.

- Set HERMES_DESKTOP_IGNORE_EXISTING so an installed runtime is never used.
- Refuse the bootstrap on the light variant without setting that latch.
- Never enumerate "This device" in the gateway roster.
- Tell the setup screen it runs on the light variant, so it can hide the
  local install option.

diff --git a/apps/desktop/electron/entry.ts b/apps/desktop/electron/entry.ts
index abed288fe2ac5b5d6d17a715798f1ad15dde4339..5cb302279a34c2790597d997a30063fdc5d3a96c 100644
--- a/apps/desktop/electron/entry.ts
+++ b/apps/desktop/electron/entry.ts
@@ -30,6 +30,21 @@ function configuredElectronFlags(env: NodeJS.ProcessEnv): string[] {
   }
 }
 
+// hermes-desktop-portable: portable, remote-only policy, through switches
+// upstream already honors. They must be set before main is imported.
+// - All state (userData, and the Hermes home that holds logs and
+//   config.yaml) lives in data\ next to the executable, so deleting the
+//   unpacked folder removes everything. HERMES_HOME is pinned too, because
+//   an inherited one (left by an official install) would win over data\.
+// - No hermes:// handler in the registry.
+// - Never use a Hermes runtime installed on this machine.
+if (process.platform === 'win32' && app.isPackaged) {
+  process.env.HERMES_DESKTOP_USER_DATA_DIR ||= path.join(path.dirname(process.execPath), 'data')
+  process.env.HERMES_HOME = path.join(process.env.HERMES_DESKTOP_USER_DATA_DIR, 'hermes-home')
+  process.env.HERMES_DESKTOP_SKIP_PROTOCOL_REGISTRATION = '1'
+  process.env.HERMES_DESKTOP_IGNORE_EXISTING = '1'
+}
+
 const linux = process.platform === 'linux'
 const electronFlags = linux ? configuredElectronFlags(process.env) : []
 
diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index 3206f7e63c2e2e7bdbdfe49868e44303252d0264..df67d1347d1f57bc4844f75b7a79c399046af417 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -2549,7 +2549,9 @@ function broadcastBootstrapEvent(ev) {
           platform: ev.platform,
           activeRoot: ev.activeRoot,
           local: ev.local || 'none',
-          bundled: installShape() === 'bundled'
+          bundled: installShape() === 'bundled',
+          // hermes-desktop-portable: remote-only; the setup screen hides the local option.
+          light: isLightVariant()
         }
       : null
     bootstrapState.unsupportedPlatform = null
@@ -2595,7 +2597,9 @@ function promptFirstRunSetupChoice(backend) {
     platform: backend.platform || process.platform,
     activeRoot: backend.activeRoot || ACTIVE_HERMES_ROOT,
     local: backend.local || 'none',
-    bundled: installShape() === 'bundled'
+    bundled: installShape() === 'bundled',
+    // hermes-desktop-portable: remote-only; the setup screen hides the local option.
+    light: isLightVariant()
   })
 }
 
@@ -5123,6 +5127,19 @@ async function ensureRuntime(
   // will rewire startup to spawn the window first and route bootstrap events
   // to a renderer-side install overlay.
   //
+  // hermes-desktop-portable: remote-only. The light variant ships no runtime
+  // and must never install one. Unlike the bundled refusal below, this does
+  // not set bootstrapFailure: that latch is global, so a failed "This device"
+  // dial would make every later request fail, the remote primary included,
+  // until the app restarts.
+  if (backend.kind === 'bootstrap-needed' && isLightVariant()) {
+    rememberLog('[bootstrap] REFUSING installer on the light (remote-only) variant')
+
+    throw new Error(
+      'This build only connects to Hermes gateways running elsewhere; it cannot install Hermes on this computer. Add a remote gateway in Settings > Gateways.'
+    )
+  }
+
   // The artifact kind forbids bootstrap even when a caller requests repair.
   if (backend.kind === 'bootstrap-needed' && installShape() === 'bundled') {
     rememberLog('[bootstrap] REFUSING installer on a bundled install; payload missing or damaged — reinstall the app')
@@ -7915,6 +7932,15 @@ let _secretStoragePolicy: SecretStoragePolicy | null = null
 
 function secretStoragePolicy(): SecretStoragePolicy {
   if (!_secretStoragePolicy) {
+    // hermes-desktop-portable: portable data sits in a plain folder, so
+    // on Windows default to DPAPI encryption until the user chooses otherwise.
+    // DPAPI never prompts, unlike the macOS keychain this default avoids.
+    if (IS_WINDOWS && !fs.existsSync(SECRET_STORAGE_POLICY_PATH)) {
+      setSecretStoragePolicy({ on: true, migrated: true })
+
+      return _secretStoragePolicy!
+    }
+
     _secretStoragePolicy = readSecretStoragePolicy(_secretStoragePolicyIo)
   }
 
@@ -15001,7 +15027,9 @@ async function enumerateRegistryAgentSources(registry = readDesktopConnectionsRe
                 profileRemoteOverride: Boolean(profileHasRemoteOverride(primaryProfileKey()))
               })
 
-              if (shouldDeferLocalEnumeration(localRoute, backendPool.keys(), connection.id)) {
+              // hermes-desktop-portable: remote-only. The light variant has no
+              // local runtime, so "This device" is never enumerated.
+              if (isLightVariant() || shouldDeferLocalEnumeration(localRoute, backendPool.keys(), connection.id)) {
                 return { connection, profiles: null, error: 'connect-on-demand' }
               }
             }
diff --git a/apps/desktop/electron/product-identity.ts b/apps/desktop/electron/product-identity.ts
index 8ca5f6cf1206550dc50ecdcdea68fbe6e5854a36..0aacef9e974356cf9bc321ea2bc3e271b8250aae 100644
--- a/apps/desktop/electron/product-identity.ts
+++ b/apps/desktop/electron/product-identity.ts
@@ -40,7 +40,14 @@ export function applyDesktopIdentity(
   }
 
   const userData: string = path.join(app.getPath('appData'), identity.appNamePascal)
-  mkdirSync(userData, { recursive: true })
+
+  // hermes-desktop-portable: portable data. main.ts moves userData to this
+  // override right after; creating the default folder here would leave an
+  // empty %APPDATA%\Hermes behind.
+  if (!process.env.HERMES_DESKTOP_USER_DATA_DIR) {
+    mkdirSync(userData, { recursive: true })
+  }
+
   app.setPath('userData', userData)
   app.setName(identity.displayName)
 
