From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hermes-desktop-portable <build@hermes-desktop-portable.invalid>
Date: Thu, 22 Oct 2026 19:01:58 +0000
Subject: [PATCH] Hide the local install option on the setup screen

hermes-desktop-portable ships upstream's light variant, which has no local
runtime and only connects to Hermes gateways running elsewhere. Upstream's
first-run screen still offers "Install Hermes locally" and says where it
would install. When the main process reports the light variant, show only
"Connect to existing Hermes".

diff --git a/apps/desktop/src/components/desktop-install-overlay.tsx b/apps/desktop/src/components/desktop-install-overlay.tsx
index 0cc4d279faa81e0294be51b03e2359ef42b54fc4..1fd488b824cefe51e31e177e4433f58cba0f1d30 100644
--- a/apps/desktop/src/components/desktop-install-overlay.tsx
+++ b/apps/desktop/src/components/desktop-install-overlay.tsx
@@ -211,7 +211,8 @@ function applyEvent(state: DesktopBootstrapState, ev: DesktopBootstrapEvent): De
             platform: ev.platform || state.setupChoice?.platform || 'unknown',
             activeRoot: ev.activeRoot || state.setupChoice?.activeRoot || '',
             local: ev.local || state.setupChoice?.local || 'none',
-            bundled: Boolean(ev.bundled)
+            bundled: Boolean(ev.bundled),
+            light: Boolean(ev.light)
           }
         : null,
       unsupportedPlatform: null,
@@ -443,6 +444,8 @@ export function DesktopInstallOverlay({ enabled = true }: DesktopInstallOverlayP
   if (state.setupChoice) {
     const localState = state.setupChoice.local
     const localPres = localCardPresentation(localState)
+    // hermes-desktop-portable: remote-only. The light variant offers no local install.
+    const remoteOnly = Boolean(state.setupChoice.light)
 
     return (
       <div className="fixed inset-0 z-(--z-setup) flex items-center justify-center bg-background/90 p-4 backdrop-blur-md">
@@ -451,13 +454,13 @@ export function DesktopInstallOverlay({ enabled = true }: DesktopInstallOverlayP
             <BrandMark className="size-11 shrink-0" />
             <div className="min-w-0">
               <h2 className="text-xl font-semibold tracking-tight">{copy.setupChoiceTitle}</h2>
-              <p className="mt-1.5 text-sm text-muted-foreground">
+              <p className="mt-1.5 text-sm text-muted-foreground" hidden={remoteOnly}>
                 {localState === 'none' ? copy.setupChoiceDesc : copy.setupChoiceDescLocal}
               </p>
             </div>
           </div>
 
-          <div className="mt-6 grid gap-3 sm:grid-cols-2">
+          <div className={remoteOnly ? 'mt-6 grid gap-3' : 'mt-6 grid gap-3 sm:grid-cols-2'}>
             <button
               className="rounded-lg border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) p-4 text-left transition hover:bg-(--chrome-action-hover)"
               onClick={() => setRemoteOpen(true)}
@@ -473,6 +476,7 @@ export function DesktopInstallOverlay({ enabled = true }: DesktopInstallOverlayP
             <button
               className="rounded-lg border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) p-4 text-left transition hover:bg-(--chrome-action-hover) disabled:cursor-not-allowed disabled:opacity-60"
               disabled={localStarting}
+              hidden={remoteOnly}
               onClick={async () => {
                 setLocalStart({ root: activeRoot, starting: true, error: null })
 
@@ -509,7 +513,7 @@ export function DesktopInstallOverlay({ enabled = true }: DesktopInstallOverlayP
             </div>
           ) : null}
 
-          {localPres.showInstallTo ? (
+          {localPres.showInstallTo && !remoteOnly ? (
             <div className="mt-6 text-xs text-muted-foreground">
               {copy.installTo}{' '}
               <code className="font-mono text-(--ui-text-secondary)">{state.setupChoice.activeRoot}</code>
diff --git a/apps/desktop/src/global.d.ts b/apps/desktop/src/global.d.ts
index b266da09084b763017fd34ad93e0aba8dda2d700..673b2eb8bc2044157d05c5309e579c770d9af117 100644
--- a/apps/desktop/src/global.d.ts
+++ b/apps/desktop/src/global.d.ts
@@ -1477,6 +1477,8 @@ export interface DesktopBootstrapSetupChoice {
   local: 'none' | 'installed' | 'bundled'
   /** This artifact is a bundled install (payload ships in-app). */
   bundled: boolean
+  /** hermes-desktop-portable: the light (remote-only) variant; no local option. */
+  light?: boolean
 }
 
 export interface DesktopBootstrapState {
@@ -1502,6 +1504,7 @@ export type DesktopBootstrapEvent =
       activeRoot?: string
       local?: DesktopBootstrapSetupChoice['local']
       bundled?: boolean
+      light?: boolean
     }
   | { type: 'manifest'; stages: DesktopBootstrapStageDescriptor[]; protocolVersion: number | null }
   | {
